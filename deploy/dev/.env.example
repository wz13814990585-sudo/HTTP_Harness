# Copy to deploy/dev/.env and replace every placeholder locally. Never commit .env.
# The DB password must be URL-safe ASCII because it is interpolated into the DSN.
HNH_DB_PASSWORD=replace-with-url-safe-random-value
HNH_DEV_TOKEN=replace-with-different-random-token
HNH_DEEPSEEK_API_KEY=replace-with-local-secret
HNH_DEEPSEEK_MODEL=deepseek-flash
HNH_DEEPSEEK_REASONING_EFFORT=none
# Optional strategy classifier. Keep disabled until a key and evaluation plan exist.
HNH_TYPESAFE_ENABLED=0
TYPESAFE_API_KEY=replace-with-local-secret
HNH_TYPESAFE_MODEL=jev-latest
HNH_TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
HNH_TYPESAFE_TIMEOUT_SECONDS=2
HNH_TYPESAFE_MIN_CONFIDENCE=0.80
HNH_HTTP_PORT=8080
# Optional: HTTPS OTLP/HTTP /v1/traces URL for API spans; leave unset by default.
# HNH_OTLP_TRACES_ENDPOINT=https://collector.example/v1/traces
